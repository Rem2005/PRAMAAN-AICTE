# Copy to .env and adjust. Never commit the real .env — it is gitignored.

# Runtime
APP_ENV=development
LOG_LEVEL=INFO

# Present in Settings but not read by any code path yet; kept so this file
# stays complete. Do not treat it as an active credential.
SECRET_KEY=

# Database. Target for real deployments is PostgreSQL (docs/architecture.md);
# the test suite runs against SQLite.
DATABASE_URL=postgresql://localhost:5432/pramaan

# Comma-separated origins allowed to call the API with credentials.
# Cookie auth only works for origins listed here.
CORS_ORIGINS=http://localhost:5173

# Uploads
MAX_UPLOAD_SIZE_MB=5
ALLOWED_UPLOAD_EXTENSIONS=.csv

# Authentication
# PBKDF2-HMAC-SHA256 work factor. Engineering parameter, not a compliance claim.
PASSWORD_HASH_ITERATIONS=600000
# Server-side session lifetime.
SESSION_TTL_HOURS=12
# Set to true when serving over HTTPS so the session cookie is Secure.
COOKIE_SECURE=false

# Used only by `python -m app.cli create-user`; read once and never stored.
# Leave unset for normal operation.
# NEW_USER_PASSWORD=

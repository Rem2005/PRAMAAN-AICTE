# PRAMAAN-AICTE frontend development environment.
#
# The browser calls same-origin paths (/api, /health) and Vite proxies them to
# the FastAPI backend, so the session cookie stays first-party (SameSite=Lax).
# Point this at wherever the backend actually listens.
VITE_API_PROXY_TARGET=http://127.0.0.1:8002

# Only set this if the API is not reachable through the Vite proxy. A
# cross-origin value also needs that origin in the backend's CORS_ORIGINS, and
# cookie auth there additionally requires HTTPS with SameSite=None.
# VITE_API_BASE_URL=http://127.0.0.1:8002
